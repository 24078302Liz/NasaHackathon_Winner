# LLM (DeepSeek through an OpenAI-compatible API)
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_MODEL=deepseek-v4-flash
SMALL_MODEL=deepseek-v4-flash
LLM_TIMEOUT_SECONDS=45

# ── Embedding（HuggingFace BGE）──
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_DEVICE=cpu

# ── Milvus ──
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=flame_evidence

# Unstructured (hosted API configuration)
UNSTRUCTURED_API_KEY=
UNSTRUCTURED_API_URL=

# Structured storage (SQLite)
DATABASE_URL=sqlite:///./data/flame.db

# Retrieval
TOP_K=10
RETRIEVAL_SCORE_THRESHOLD=0.0

# JSON array of allowed frontend origins; same-origin hosting needs no CORS.
CORS_ORIGINS=["http://localhost:5500","http://127.0.0.1:5500","https://winner-flame-in-freefall.vercel.app"]
WORKFLOW_TIMEOUT_SECONDS=180
